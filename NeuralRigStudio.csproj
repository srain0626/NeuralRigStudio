<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>3.0.0</Version>
    <Authors>Ray Kim</Authors>
    <Company>NeuralRig Audio</Company>
    <Copyright>Copyright (c) 2026 Ray Kim</Copyright>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>false</ForceDesignerDpiUnaware>
    <DefaultItemExcludes>$(DefaultItemExcludes);src\**;tools\**;web-ui\**;wwwroot\**;cloud\**;packages\**;installer\**;scripts\**;dist-release\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src\NeuralRig.Core\NeuralRig.Core.csproj" />
    <ProjectReference Include="src\NeuralRig.Plugin\NeuralRig.Plugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="NAudio.Asio" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(EmbedWwwRootBundle)' != 'true'">
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(EmbedWwwRootBundle)' == 'true' AND Exists('obj\wwwroot.bundle.zip')">
    <EmbeddedResource Include="obj\wwwroot.bundle.zip" LogicalName="NeuralRigStudio.wwwroot.zip" />
  </ItemGroup>

</Project>
