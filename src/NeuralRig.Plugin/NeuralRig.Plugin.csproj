<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Ray Kim</Authors>
    <Company>NeuralRig Audio</Company>
    <Copyright>Copyright (c) 2026 Ray Kim</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NeuralRigStudio.Plugin</RootNamespace>
    <AssemblyName Condition="'$(PublishAot)' == 'true'">NeuralRig.NativeCore</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);CA1416;IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeuralRig.Core\NeuralRig.Core.csproj" />
  </ItemGroup>

</Project>
